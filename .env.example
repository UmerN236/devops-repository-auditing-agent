# Copy to .env and fill in. Any OpenAI-compatible chat-completions endpoint with tool calling works.

# Required: API key for the provider below.
LLM_API_KEY=

# Model name for that provider. Default setup: OpenRouter free models (https://openrouter.ai/keys).
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional, OpenRouter only: comma-separated models tried when the primary is rate-limited/unavailable.
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free

# Endpoint; leave empty for OpenAI. Examples:
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/   (LLM_MODEL=gemini-3.8-flash)
#   Groq:          https://api.groq.com/openai/v1                             (LLM_MODEL=llama-3.3-70b-versatile)
#   OpenRouter:    https://openrouter.ai/api/v1                               (LLM_MODEL=<vendor>/<model>)
#   Ollama:        http://localhost:11434/v1                                  (LLM_MODEL=qwen2.5:14b, any key)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Sampling temperature. Leave empty for models that reject the parameter (e.g. reasoning models).
LLM_TEMPERATURE=

# Optional reasoning effort; only set when your chosen model supports it.
# gpt-5.4-mini supports medium; Gemini's compatibility endpoint supports low/medium/high.
LLM_REASONING_EFFORT=

# Per-request timeout in seconds (SDK retries transient errors twice).
LLM_TIMEOUT=90
